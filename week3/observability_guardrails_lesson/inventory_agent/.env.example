# Copy this file to .env and fill in your values.

# Needed by every version
OPENAI_API_KEY=sk-your-openai-key

# Needed by v5-v7 (email alerts). For Gmail, create an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=manager@example.com

# Needed by v6-v7 (tracing). Free account at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=inventory-agent
