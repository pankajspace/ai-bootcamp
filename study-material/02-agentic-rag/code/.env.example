# ============================================================
# Agentic RAG project - created by Shivank Agrawal
# 1) Copy this file and rename the copy to:  .env
# 2) Paste your own keys after the = sign (no quotes, no spaces)
# 3) NEVER share or upload your .env file
# ============================================================

# --- API keys -------------------------------------------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# --- Main brain for the 5 agents --------------------------------
# openrouter = DeepSeek in the cloud (tiny pay-as-you-go cost)
# groq       = free-tier practice model (not DeepSeek)
# ollama     = DeepSeek on your laptop (free, slow, ~8 GB RAM)
LLM_MODE=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Fast LLM inside the RAG tool -------------------------------
# groq = fast cloud model   |   same = reuse the main brain
RAG_LLM_MODE=groq
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings + document ---------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PDF_PATH=data/attention_is_all_you_need.pdf
# PDF_TOPIC=one line describing what is inside YOUR pdf

# --- Limits -------------------------------------------------------
TOP_K=4
MAX_RPM=10
