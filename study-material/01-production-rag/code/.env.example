# Copy this file to .env and edit what you need.  (cp .env.example .env)
# Everything is optional: with no changes, the labs run fully locally with no API key.

# ---------- Embeddings ----------
# fastembed (default, local, downloads the model once) | openai | wordllama (offline) | hashing (toy)
EMBEDDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
# For Hindi/Tamil/other languages try:  EMBED_MODEL=intfloat/multilingual-e5-large

# ---------- Reranker (Lab 08 and the app) ----------
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Stronger + multilingual (bigger download): BAAI/bge-reranker-v2-m3

# ---------- LLM (pick ONE) ----------
# Leave both keys empty to use the free "extractive" answer mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai | anthropic | ollama | none     (auto-detected from the keys if empty)
LLM_PROVIDER=
# Defaults: openai -> gpt-6-luna, anthropic -> claude-haiku-5-5, ollama -> llama3.2
LLM_MODEL=
# For Ollama (free, local):  LLM_PROVIDER=ollama and LLM_MODEL=llama3.2  (run `ollama pull llama3.2` first)
# For any OpenAI-compatible server (Groq, OpenRouter, vLLM, LM Studio): set OPENAI_BASE_URL and OPENAI_API_KEY
OPENAI_BASE_URL=
# Only set this if your model accepts it (many reasoning models only allow the default)
LLM_TEMPERATURE=

# ---------- Answering ----------
# Refuse when the best chunk is less similar than this. Lab 09 helps you pick a value for your model.
MIN_SIMILARITY=

# ---------- Production app (Module 13) ----------
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
USE_RERANKER=1
# S3_BUCKET=           # set to store originals in S3/MinIO instead of the local ./blobs folder
# S3_ENDPOINT_URL=http://localhost:9000
