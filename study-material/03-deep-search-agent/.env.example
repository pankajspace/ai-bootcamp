# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit it.   (macOS/Linux: cp .env.example .env
#                                           Windows:     copy .env.example .env)
# Lines starting with # are ignored. Never commit your real .env to Git.
# ---------------------------------------------------------------------------

# 1) WHICH LLM? -------------------------------------------------------------
# mock = no LLM at all (rule-based stand-ins). Everything runs offline. START HERE.
LLM_PROVIDER=mock

# --- Free / cheap options (pick ONE, uncomment its lines) -------------------
# Google Gemini (free tier; key from https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# LLM_MODEL=gemini-3.8-flash

# Groq (free plan with rate limits; key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-20b

# Ollama (100% local and free; install from https://ollama.com, then: ollama pull qwen3:8b)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# --- Paid options -----------------------------------------------------------
# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key
# LLM_MODEL=gpt-6-luna
# LLM_REASONING_EFFORT=none      # gpt-6-luna needs this for function calling in Lab 2

# Anthropic (through its OpenAI-SDK compatibility layer — fine for learning)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key
# LLM_MODEL=claude-haiku-5-5

# Any other OpenAI-compatible server
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=anything
# LLM_MODEL=your-model

# Optional: a cheaper model only for claim extraction (model routing). Empty = same model.
# LLM_SMALL_MODEL=
# Optional: force a temperature (some reasoning models reject anything but the default)
# LLM_TEMPERATURE=0

# 2) WHICH SEARCH? ----------------------------------------------------------
# offline = the fictional NimbusPay web in data/corpus.json (repeatable, safe)
SEARCH_PROVIDER=offline
# ddgs    = real web search, no key needed
# SEARCH_PROVIDER=ddgs
# tavily  = real web search API built for agents (free monthly credits at https://tavily.com)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-your-key

# 3) AGENT SETTINGS (defaults are fine) --------------------------------------
# DS_AS_OF=2026-11-01        # "today" for freshness maths (offline mode pins this date)
# DS_MAX_ITERATIONS=3
# DS_MAX_PARALLEL=4          # parallel workers
# DS_RESULTS_PER_QUERY=3     # pages read per search query
# DS_VERBOSE=1
# PRICE_IN_PER_MTOK=0.10     # your model's real price per 1M input tokens (for cost estimates)
# PRICE_OUT_PER_MTOK=0.50
