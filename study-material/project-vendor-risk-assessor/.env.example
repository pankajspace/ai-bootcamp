# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit it.   (macOS/Linux: cp .env.example .env
#                                           Windows:     copy .env.example .env)
# Lines starting with # are ignored. NEVER commit your real .env to Git (.gitignore already excludes it).
# ---------------------------------------------------------------------------

# 1) WHICH LLM? -------------------------------------------------------------
# mock = no LLM at all (rule-based stand-ins). Everything runs offline. START HERE.
LLM_PROVIDER=mock

# --- Free / cheap options (pick ONE, uncomment its lines) -------------------
# Google Gemini (free tier; key from https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# LLM_MODEL=gemini-3.8-flash

# Groq (free plan with rate limits; key from https://console.groq.com/keys)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-20b

# Ollama (100% local and free; install from https://ollama.com, then: ollama pull qwen3:8b)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# OpenRouter (DeepSeek etc.; key from https://openrouter.ai)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key
# LLM_MODEL=deepseek/deepseek-chat

# --- Paid options -----------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key
# LLM_MODEL=gpt-6-luna

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key
# LLM_MODEL=claude-haiku-5-5

# Optional: a cheaper model for claim extraction only (model routing). Empty = same model.
# LLM_SMALL_MODEL=
# LLM_TEMPERATURE=0

# 2) WHICH SEARCH? ----------------------------------------------------------
# offline = the fictional vendor web in data/vendor_web/corpus.json (repeatable, safe, free)
SEARCH_PROVIDER=offline
# ddgs    = real web search, no key needed          (pip install ddgs trafilatura)
# SEARCH_PROVIDER=ddgs
# tavily  = real web search API built for agents    (free monthly credits at https://tavily.com)
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-your-key

# 3) AGENT SETTINGS (defaults are fine) --------------------------------------
# VRA_AS_OF=2026-11-01         # "today" for freshness maths (offline mode pins this date from the corpus)
# VRA_MAX_USD=0.50             # hard budget per assessment in live mode
# VRA_MAX_PARALLEL=4
# VRA_RESULTS_PER_QUERY=5
# VRA_VERBOSE=1
# PRICE_IN_PER_MTOK=0.10       # your model's real price per 1M input tokens (for cost estimates)
# PRICE_OUT_PER_MTOK=0.50
