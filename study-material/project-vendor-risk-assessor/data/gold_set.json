        "data_regions": {"available": ["United States", "European Union"], "india_available": false},
        "trains_on_customer_data": "no_on_paid_plans",
        "subprocessors": {"count": 4, "has_model_provider": true},
        "data_retention": {"default_days": 30, "deletion_on_request_days": 30},
        "sso_saml": "paid_plans",
        "security_incidents": {"major_count": 1, "all_major_have_postmortem": true},
        "dpa_available": "yes"
      },
      "expected_verdicts": {
        "SEC-4.2": "PASS",
        "DP-3.1": "FAIL",
        "AI-2.1": "NEEDS_REVIEW",
        "AI-3.4": "NEEDS_REVIEW",
        "DP-5.4": "PASS",
        "SEC-7.1": "PASS",
        "SEC-9.3": "NEEDS_REVIEW",
        "DP-2.2": "PASS",
        "PROC-1.1": "NEEDS_REVIEW"
