# =============================================================================
# Root Environment Variables Configuration Template
# Copy this file to .env and replace placeholder values with your real keys:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Web Search & Data APIs
# -----------------------------------------------------------------------------
# Tavily Search API Key (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Financial Modeling Prep API Key (https://financialmodelingprep.com)
FINANCIAL_MODELING_PREP_API_KEY=your_fmp_api_key_here

# Hugging Face Access Token (https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# Default Models & Local LLMs
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=gemma3:270m

# -----------------------------------------------------------------------------
# Observability & Tracing (LangSmith)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=section-01-langchain-foundations
# Optional endpoint (e.g. APAC region):
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# -----------------------------------------------------------------------------
# AWS / Amazon Bedrock
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_NOVA_LITE=amazon.nova-lite-v1:0
AWS_SESSION_TOKEN=
