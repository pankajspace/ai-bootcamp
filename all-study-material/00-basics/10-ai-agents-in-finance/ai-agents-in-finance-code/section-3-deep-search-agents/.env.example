# Copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=sk-...
# https://financialdatasets.ai — company financials and price snapshots
FINANCIAL_DATASETS_API_KEY=...
# https://tavily.com — news search
TAVILY_API_KEY=tvly-...
# SEC EDGAR asks every client to identify itself with a contact e-mail (no key needed)
SEC_EDGAR_EMAIL=your-email@example.com
# Optional: to use Claude, set this and change PLANNING_MODEL / SYNTHESIS_MODEL in common.py
# ANTHROPIC_API_KEY=sk-ant-...
